# pixelflux/web/app/Dockerfile
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_BASE
ARG NEXT_PUBLIC_AUDIT_HOST
ARG NEXT_PUBLIC_WHATSAPP_TO
ARG NEXT_PUBLIC_WABA_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ENV NEXT_PUBLIC_AUDIT_HOST=${NEXT_PUBLIC_AUDIT_HOST}
ENV NEXT_PUBLIC_WHATSAPP_TO=${NEXT_PUBLIC_WHATSAPP_TO}
ENV NEXT_PUBLIC_WABA_URL=${NEXT_PUBLIC_WABA_URL}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_BASE
ARG NEXT_PUBLIC_AUDIT_HOST
ARG NEXT_PUBLIC_WHATSAPP_TO
ARG NEXT_PUBLIC_WABA_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ENV NEXT_PUBLIC_AUDIT_HOST=${NEXT_PUBLIC_AUDIT_HOST}
ENV NEXT_PUBLIC_WHATSAPP_TO=${NEXT_PUBLIC_WHATSAPP_TO}
ENV NEXT_PUBLIC_WABA_URL=${NEXT_PUBLIC_WABA_URL}
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
EXPOSE 3000
CMD ["npm","start"]
