# --- Base de datos ---
DATABASE_URL=mysql+pymysql://demo_user:CHANGE_ME@db_demo:3306/pixelflux_demo

# --- Modo demo (gatea scraper real, re-analyze, IA en vivo, envío WABA real) ---
DEMO_READONLY=true

# --- Auth ---
JWT_SECRET=CHANGE_ME_generate_a_random_secret
ADMIN_EMAIL=demo@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- CORS / hosts públicos de la demo ---
CORS_ORIGINS=https://demo.pixelfluxcreative.com
AUDIT_HOST=https://demo.pixelfluxcreative.com

# --- Frontend (Next.js, deben empezar con NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_BASE_URL=https://demo-api.pixelfluxcreative.com
NEXT_PUBLIC_API_BASE=https://demo-api.pixelfluxcreative.com
NEXT_PUBLIC_AUDIT_HOST=https://demo.pixelfluxcreative.com
# Placeholder, no un número real — el botón de WhatsApp de la auditoría
# apunta acá. Sin definir, cae en un número no funcional a propósito.
NEXT_PUBLIC_WHATSAPP_TO=10000000000

# --- Integraciones externas: NO se usan en modo demo ---
# El scraper real y el envío de WhatsApp/Meta están deshabilitados/mockeados
# en esta versión. Estas variables existen solo por compatibilidad con el
# código real y pueden dejarse vacías.
OPENAI_API_KEY=
META_SYSTEM_USER_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
